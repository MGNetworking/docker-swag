# Réglages non secrets, lus par docker compose (SWAG n'a besoin d'aucun mot de passe). Détail de chaque réglage : docs/parametres.md
# Domaine principal (certificat Let's Encrypt, validation HTTP : son DNS doit pointer vers ce serveur, le port 80 être joignable).
URL=exemple.fr
# Sous-domaines, séparés par des virgules, SANS le domaine : ils sont ajoutés au MÊME certificat.
SUBDOMAINS=app,keycloak
# Autres domaines complets, séparés par des virgules (laisser vide s'il n'y en a pas).
EXTRA_DOMAINS=
# Adresse pour les avis d'expiration Let's Encrypt : À RENSEIGNER.
EMAIL=
# true : serveur d'essai de Let's Encrypt (certificat non reconnu des navigateurs, sans limite) pour un premier essai.
STAGING=false
ONLY_SUBDOMAINS=false
TZ=Europe/Paris
HTTP_PORT=80
HTTPS_PORT=443
PROXY_NETWORK=proxy
