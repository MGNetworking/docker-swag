# Copier en .env (non versionné). Aucun secret ici : SWAG n'a besoin que d'un nom de domaine et d'une adresse électronique.
# Domaine principal (certificat Let's Encrypt, validation HTTP : son DNS doit pointer vers ce serveur, le port 80 être joignable).
URL=exemple.fr
# Sous-domaines, séparés par des virgules, SANS le domaine : ils sont ajoutés au MÊME certificat.
SUBDOMAINS=app,keycloak
# Autres domaines complets (facultatif), séparés par des virgules.
#EXTRA_DOMAINS=autre-domaine.fr,app.autre-domaine.fr
# Adresse pour les avis d'expiration Let's Encrypt.
EMAIL=
# true : serveur d'essai de Let's Encrypt (certificat non reconnu des navigateurs, sans limite) pour un premier essai.
STAGING=false
# Facultatifs
#ONLY_SUBDOMAINS=false
#TZ=Europe/Paris
#HTTP_PORT=80
#HTTPS_PORT=443
#PROXY_NETWORK=proxy
